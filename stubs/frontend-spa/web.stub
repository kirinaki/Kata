<?php

use Illuminate\Support\Facades\Route;
use Inertia\Inertia;
use Modules\{{ module }}\Http\Middlewares\HandleInertiaRequests;

/*
|--------------------------------------------------------------------------
| Rutas web del módulo {{ module }} (SPA con Inertia + React)
|--------------------------------------------------------------------------
|
| El middleware HandleInertiaRequests se aplica SOLO a las rutas de este
| módulo (no al grupo web global). Así, si varias SPA definen una página
| "Home", cada una usa su propia rootView y su propio bundle sin colisión.
|
*/

Route::middleware(['web', HandleInertiaRequests::class])
    ->prefix('{{ nameKebab }}')
    ->name('{{ nameLower }}.')
    ->group(function () {
        Route::get('/', function () {
            return Inertia::render('Home');
        })->name('home');
    });
