{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["vite/client"],
        "baseUrl": ".",
        "paths": {
            "@assets/*": ["Resources/Assets/*"],
            "@islands/*": ["Resources/Islands/*"]
        }
    },
    "include": ["Resources/**/*.ts", "Resources/**/*.tsx"]
}
