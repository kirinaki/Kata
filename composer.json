{
    "name": "kirinaki/kata",
    "description": "Plugin base para Laravel (Kata).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "package", "kata"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Kata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kata\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kata\\KataServiceProvider"
            ],
            "aliases": {
                "Kata": "Kata\\Facades\\Kata"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
